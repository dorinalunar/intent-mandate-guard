{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentmandateguard.local/schemas/code_snapshot.json",
  "title": "IntentMandateGuard CODE_SNAPSHOT",
  "type": "object",
  "required": [
    "commit",
    "evidence_hash",
    "contract_hash",
    "timestamp",
    "evidence_hash_algo",
    "contract_hash_algo"
  ],
  "properties": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_hash_algo": {
      "type": "string",
      "const": "sha256(git_rev_parse_HEAD)"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_hash_algo": {
      "type": "string",
      "const": "sha256(contracts/IntentMandateGuard.py)"
    },
    "timestamp": {
      "type": "string",
      "minLength": 10
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
